    function resetCurrentTool() {
      if (APP_STATE.isRequestInFlight) return;
      if (APP_STATE.activeToolId) {
        openToolWorkspace(APP_STATE.activeToolId);
      }
    }

    /**************************************************************
     * 8. دوال العرض الموحدة للنتائج والأخطاء والنسخ
     **************************************************************/
    function setToolLoadingState(isLoading, loadingText = 'جارٍ التحليل والمعالجة...') {
      APP_STATE.isRequestInFlight = isLoading;
      const btn = document.getElementById('primaryActionBtn');
      if (!btn) return;

      if (isLoading) {
        btn.disabled = true;
        btn.dataset.originalHtml = btn.innerHTML;
        btn.innerHTML = `<span class="loading-spinner"></span><span>${loadingText}</span>`;
      } else {
        btn.disabled = false;
        if (btn.dataset.originalHtml) {
          btn.innerHTML = btn.dataset.originalHtml;
        }
      }
    }

    function renderToolOutput(markdownText, noticeBannerText = '') {
      const container = document.getElementById('toolOutputContainer');
      if (!container) return;
      container.innerHTML = '';

      if (noticeBannerText) {
        const notice = document.createElement('div');
        notice.className = 'warning-alert';
        notice.textContent = noticeBannerText;
        container.appendChild(notice);
      }

      const box = document.createElement('div');
      box.className = 'ai-output-box';

      const contentDiv = document.createElement('div');
      contentDiv.id = 'sanitizedResultContent';
      contentDiv.innerHTML = renderSafeMarkdown(markdownText);
      box.appendChild(contentDiv);

      const actionsDiv = document.createElement('div');
      actionsDiv.className = 'output-actions';

      const copyBtn = document.createElement('button');
      copyBtn.className = 'btn-secondary';
      copyBtn.innerHTML = '<i class="fa-solid fa-copy"></i> <span>نسخ النتيجة</span>';
      copyBtn.onclick = () => {
        navigator.clipboard.writeText(contentDiv.innerText).then(() => {
          copyBtn.innerHTML = '<i class="fa-solid fa-check"></i> <span>تم النسخ بنجاح!</span>';
          setTimeout(() => {
            copyBtn.innerHTML = '<i class="fa-solid fa-copy"></i> <span>نسخ النتيجة</span>';
          }, 2000);
        });
      };

      const clearBtn = document.createElement('button');
      clearBtn.className = 'btn-secondary';
      clearBtn.style.borderColor = 'var(--danger)';
      clearBtn.style.color = 'var(--danger)';
      clearBtn.innerHTML = '<i class="fa-solid fa-trash"></i> <span>مسح النتيجة</span>';
      clearBtn.onclick = () => {
        container.innerHTML = '';
      };

      actionsDiv.appendChild(copyBtn);
      actionsDiv.appendChild(clearBtn);
      box.appendChild(actionsDiv);
      container.appendChild(box);
    }

    function renderToolError(errorMessage, retryFn = null) {
      const container = document.getElementById('toolOutputContainer');
      if (!container) return;
      container.innerHTML = '';

      const alertBox = document.createElement('div');
      alertBox.className = 'error-alert';

      const msgRow = document.createElement('div');
      msgRow.style.display = 'flex';
      msgRow.style.alignItems = 'center';
      msgRow.style.gap = '10px';

      const icon = document.createElement('i');
      icon.className = 'fa-solid fa-circle-exclamation';
      const textSpan = document.createElement('span');
      textSpan.textContent = errorMessage; // آمن ضد XSS

      msgRow.appendChild(icon);
      msgRow.appendChild(textSpan);
      alertBox.appendChild(msgRow);

      if (retryFn) {
        APP_STATE.lastRetryCallback = retryFn;
        const retryBtn = document.createElement('button');
        retryBtn.className = 'btn-secondary';
        retryBtn.style.alignSelf = 'flex-start';
        retryBtn.innerHTML = '<i class="fa-solid fa-rotate-right"></i> إعادة المحاولة';
        retryBtn.onclick = () => {
          if (APP_STATE.lastRetryCallback) APP_STATE.lastRetryCallback();
        };
        alertBox.appendChild(retryBtn);
      }

      container.appendChild(alertBox);
    }

    /**************************************************************
     * 9. المنطق الفعلي للأدوات الثماني (Prompts احترافية + معالجة حقيقية)
     **************************************************************/

    // 1. MedRecall
    async function executeMedRecall() {
      if (APP_STATE.isRequestInFlight) return;
      const text = document.getElementById('recallInput').value.trim();
      const type = document.getElementById('recallType').value;
      const difficulty = document.getElementById('recallDifficulty').value;
      const count = Math.min(Math.max(parseInt(document.getElementById('recallCount').value, 10) || 5, 3), 15);
      const strictSource = document.getElementById('recallStrictSource').checked;

      if (!text) {
        renderToolError('يرجى إدخال نص المحاضرة أو الملاحظات العلمية أولاً.');
        return;
      }

      setToolLoadingState(true, 'جارٍ صياغة الأسئلة والبطاقات من النص...');
      document.getElementById('toolOutputContainer').innerHTML = '';

      const systemInstruction = `أنت أستاذ طب خبير في القياس والتقويم الطبي. مهمتك تحويل محتوى المحاضرة المقدم من الطالب إلى أسئلة وبطاقات استذكار دقيقة.
القواعد الإلزامية:
1. نوع المخرجات المطلوب: (${type})، العدد: (${count})، مستوى الصعوبة: (${difficulty}).
2. حافظ على جميع المصطلحات الطبية والعلمية باللغة الإنجليزية بجانب السياق العربي.
3. أظهر الإجابة الصحيحة والتفسير العلمي لكل سؤال.
4. ${strictSource
  ? 'التزم حصرياً بالمعلومات الموجودة في نص المستخدم ولا تختلق أو تضف أي معلومة من خارج النص.'
  : 'اعتمد أساساً على نص المستخدم، وإذا أضفت أي معلومة إثرائية من خارج النص لتوضيح الإجابة فيجب وضعها تحت تنبيه صريح بعنوان: [معلومة إضافية خارج نص المحاضرة].'}`;

      try {
        const output = await callGeminiAPI({
          systemInstruction,
          contents: [{ role: 'user', parts: [{ text: `نص المحاضرة:\n\n${text}` }] }]
        });
        renderToolOutput(output);
      } catch (err) {
        renderToolError(err.message, executeMedRecall);
      } finally {
        setToolLoadingState(false);
      }
    }

    // 2. FeynmanMed
    async function executeFeynmanMed() {
      if (APP_STATE.isRequestInFlight) return;
      const topic = document.getElementById('feynmanTopic').value.trim();
      const context = document.getElementById('feynmanContext').value.trim();

      if (!topic) {
        renderToolError('يرجى إدخال المفهوم الطبي أو العلمي المراد شرحه.');
        return;
      }

      setToolLoadingState(true, 'جارٍ إعداد الشرح بالمستويات الثلاثة...');
      document.getElementById('toolOutputContainer').innerHTML = '';

      const systemInstruction = `أنت معلم طبي خبير بتقنية فاينمان (Feynman Technique). اشرح المفهوم المطلوب بثلاثة مستويات منفصلة وواضحة:
- المستوى الأول (شرح مبسط جداً): شرح واضح لغير المختصين مع مثال تقاسمي أو تشبيه تدريسي، مع التنبيه صراحة أن التشبيه تقريبي لتسهيل الفهم.
- المستوى الثاني (شرح أكاديمي لطلاب العلوم الطبية): التعريف الدقيق، المكونات الأساسية، والأهمية السريرية مع الحفاظ على المصطلحات الإنجليزية.
- المستوى الثالث (شرح متقدم بالآليات الفيزيولوجية والجزيئية): تفصيل الآليات الفيزيولوجية أو المرضية خطوة بخطوة.
افصل بوضوح تام بين الحقائق العلمية المؤكدة وبين الاستنتاجات أو التشبيهات التفسيرية.`;

      const userPrompt = context
        ? `المفهوم المطلوب: ${topic}\nسياق إضافي للتركيز عليه: ${context}`
        : `المفهوم المطلوب: ${topic}`;

      try {
        const output = await callGeminiAPI({
          systemInstruction,
          contents: [{ role: 'user', parts: [{ text: userPrompt }] }]
        });
        renderToolOutput(output);
      } catch (err) {
        renderToolError(err.message, executeFeynmanMed);
      } finally {
        setToolLoadingState(false);
      }
    }

    // 3. MedWhy Chain
    async function executeMedWhyChain() {
      if (APP_STATE.isRequestInFlight) return;
      const query = document.getElementById('whyQuery').value.trim();
      const depth = document.getElementById('whyDepth').value;

      if (!query) {
        renderToolError('يرجى إدخال الظاهرة أو الآلية الفيزيولوجية المراد تفكيكها.');
        return;
      }

      setToolLoadingState(true, 'جارٍ بناء السلسلة السببية الفيزيولوجية...');
      document.getElementById('toolOutputContainer').innerHTML = '';

      const systemInstruction = `أنت خبير في الفيزيولوجيا المرضية (Pathophysiology). مهمتك بناء سلسلة سببية منظمة (MedWhy Chain) تشرح لماذا وكيف تحدث الظاهرة التي يسأل عنها الطالب.
القواعد:
1. مستوى العمق: ${depth}.
2. انتقل خطوة بخطوة (الخطوة 1 ⬅ الخطوة 2 ⬅ الخطوة 3...) من المسبب الأولي إلى النتيجة السريرية، مع توضيح الروابط الفيزيولوجية والكيميائية الحيوية.
3. تجنب السلاسل الطويلة المفتعلة أو الأسباب غير المثبتة علمياً؛ إذا كان هناك جزء غير محسوم علمياً فاذكر ذلك بوضوح.
4. اختتم بـ "خلاصة تكاملية" تربط السلسلة كاملة مع المصطلحات الإنجليزية الأساسية.`;

      try {
        const output = await callGeminiAPI({
          systemInstruction,
          contents: [{ role: 'user', parts: [{ text: query }] }]
        });
        renderToolOutput(output);
      } catch (err) {
        renderToolError(err.message, executeMedWhyChain);
      } finally {
        setToolLoadingState(false);
      }
    }

