      });
    }

    function appendChatBubble(sender, text) {
      const chatLog = document.getElementById('patientChatLog');
      if (!chatLog) return;

      const bubble = document.createElement('div');
      bubble.className = `chat-bubble ${sender === 'user' ? 'user' : 'patient'}`;

      const label = document.createElement('div');
      label.style.fontWeight = '800';
      label.style.marginBottom = '4px';
      label.style.fontSize = '12.5px';
      label.textContent = sender === 'user' ? 'الطالب (أنت):' : 'المريض الافتراضي:';

      const body = document.createElement('div');
      if (sender === 'user') {
        body.textContent = text; // حماية كاملة ضد XSS باستخدام textContent
      } else {
        body.innerHTML = renderSafeMarkdown(text);
      }

      bubble.appendChild(label);
      bubble.appendChild(body);
      chatLog.appendChild(bubble);
      chatLog.scrollTop = chatLog.scrollHeight;
    }

    async function sendQuestionToPatient() {
      if (APP_STATE.isRequestInFlight) return;
      const qInput = document.getElementById('patientQuestionInput');
      const sendBtn = document.getElementById('sendPatientQBtn');
      const evalBtn = document.getElementById('evaluatePatientBtn');
      if (!qInput) return;

      const question = qInput.value.trim();
      if (!question) return;

      qInput.value = '';
      appendChatBubble('user', question);
      APP_STATE.patientHistory.push({ role: 'user', parts: [{ text: question }] });

      APP_STATE.isRequestInFlight = true;
      sendBtn.disabled = true;
      evalBtn.disabled = true;
      sendBtn.innerHTML = '<span class="loading-spinner"></span> <span>المريض يجيب...</span>';

      try {
        const reply = await callGeminiAPI({
          systemInstruction: PATIENT_SYSTEM_PROMPT,
          contents: APP_STATE.patientHistory
        });
        APP_STATE.patientHistory.push({ role: 'model', parts: [{ text: reply }] });
        appendChatBubble('patient', reply);
      } catch (err) {
        // التراجع عن الرسالة الأخيرة في السجل عند فشل الشبكة حتى يتمكن الطالب من إعادة إرسالها
        APP_STATE.patientHistory.pop();
        const evalBox = document.getElementById('patientEvaluationBox');
        if (evalBox) {
          evalBox.innerHTML = '';
          const errDiv = document.createElement('div');
          errDiv.className = 'error-alert';
          errDiv.textContent = `تعذر إرسال السؤال: ${err.message}`;
          evalBox.appendChild(errDiv);
        }
      } finally {
        APP_STATE.isRequestInFlight = false;
        sendBtn.disabled = false;
        evalBtn.disabled = false;
        sendBtn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> إرسال السؤال للمريض';
      }
    }

    async function finishAndEvaluatePatientCase() {
      if (APP_STATE.isRequestInFlight) return;
      const sendBtn = document.getElementById('sendPatientQBtn');
      const evalBtn = document.getElementById('evaluatePatientBtn');
      const evalBox = document.getElementById('patientEvaluationBox');

      APP_STATE.isRequestInFlight = true;
      sendBtn.disabled = true;
      evalBtn.disabled = true;
      evalBtn.innerHTML = '<span class="loading-spinner" style="border-top-color: var(--dark-green);"></span> <span>جارٍ إعداد التقييم السريري...</span>';

      const evaluationPrompt = `[تقييم الأداء السريري النهائي]: انتهت المقابلة الآن. بناءً على جميع الأسئلة التي طرحها الطالب أعلاه، قدم تقييماً تعليمياً مفصلاً ومنظماً يشمل:
1. ملخص الحالة والتشخيص التفريقي التعليمي.
2. الجوانب التي أحسن الطالب السؤال عنها في القصة المرضية.
3. النقاط الحرجة والعلامات المنذرة (Red Flags) التي أغفل الطالب السؤال عنها.
4. توجيهات سريرية منظمة لتطوير مهارة أخذ القصة المرضية.`;

      const evaluationContents = [
        ...APP_STATE.patientHistory,
        { role: 'user', parts: [{ text: evaluationPrompt }] }
      ];

      try {
        const report = await callGeminiAPI({
          systemInstruction: PATIENT_SYSTEM_PROMPT,
          contents: evaluationContents
        });

        evalBox.innerHTML = `
          <div style="margin-top: 20px; padding: 20px; border-radius: 14px; background: var(--dark-green-soft); border: 1px solid var(--dark-green);">
            <h3 style="color: var(--dark-green); margin-top: 0;"><i class="fa-solid fa-award"></i> تقرير تقييم الأداء السريري</h3>
            <div>${renderSafeMarkdown(report)}</div>
          </div>
        `;
      } catch (err) {
        evalBox.innerHTML = '';
        const errDiv = document.createElement('div');
        errDiv.className = 'error-alert';
        errDiv.textContent = `تعذر جلب التقييم: ${err.message}`;
        evalBox.appendChild(errDiv);
      } finally {
        APP_STATE.isRequestInFlight = false;
        sendBtn.disabled = false;
        evalBtn.disabled = false;
        evalBtn.innerHTML = '<i class="fa-solid fa-clipboard-check"></i> إنهاء المقابلة وتقييم أدائي السريري';
      }
    }

    // 6. MedECG Arena
    async function executeMedECGArena() {
      if (APP_STATE.isRequestInFlight) return;
      const desc = document.getElementById('ecgDesc').value.trim();
      const fileInput = document.getElementById('ecgImageInput');
      const hasFile = fileInput && fileInput.files && fileInput.files.length > 0;

      if (!desc && !hasFile) {
        renderToolError('يرجى إدخال وصف تخطيط القلب أو إرفاق صورة واضحة للتخطيط.');
        return;
      }

      setToolLoadingState(true, 'جارٍ قراءة وتحليل معطيات تخطيط القلب...');
      document.getElementById('toolOutputContainer').innerHTML = '';

      const systemInstruction = `أنت أستاذ أمراض قلبية متخصص في تدريس منهجية قراءة تخطيط القلب (ECG Interpretation).
القواعد الصارمة:
1. اعرض التحليل وفق المنهجية السريرية المنظمة:
   - جودة التخطيط والمعايرة (Calibration & Quality) إن ظهرت.
   - معدل ضربات القلب (Heart Rate).
   - النظم (Rhythm).
   - المحور الكهربائي (Cardiac Axis).
   - الموجات والفواصل (P wave, PR interval, QRS complex, ST segment, T wave, QT interval).
   - الاستنتاج التعليمي والتشخيص التفريقي.
2. لا تختلق أي قياسات رقمية بالميلي ثانية أو المربعات الصغيرة إذا لم تكن واضحة تماماً في الصورة أو مذكورة في نص المستخدم.
3. وضح القيود دائماً عندما لا تسمح جودة الصورة أو نقص المعطيات باستنتاج قاطع.
4. أكد أن التحليل لأغراض التدريب التعليمي وليس تشخيصاً سريرياً نهائياً لمريض حقيقي.`;

      try {
        const parts = [];
        if (desc) {
          parts.push({ text: `وصف التخطيط والسياق المقدم من الطالب:\n${desc}` });
        } else {
          parts.push({ text: 'حلل صورة تخطيط القلب المرفقة وفق المنهجية التعليمية المنظمة، مع بيان أي قيود في وضوح الصورة.' });
        }

        if (hasFile) {
          const imgData = await extractFileLocally('ecgImageInput');
          if (imgData && imgData.type === 'image') {
            parts.push({
              inline_data: {
                mime_type: imgData.mimeType,
                data: imgData.base64
              }
            });
          }
        }

        const output = await callGeminiAPI({
          systemInstruction,
          contents: [{ role: 'user', parts }]
        });
        renderToolOutput(output);
      } catch (err) {
        renderToolError(err.message, executeMedECGArena);
      } finally {
        setToolLoadingState(false);
      }
    }

    // 7. Page Intelligence
    async function executePageIntelligence() {
      if (APP_STATE.isRequestInFlight) return;
      const rawText = document.getElementById('pageRawText').value.trim();
      const fileInput = document.getElementById('pagePdfInput');
      const strictMode = document.getElementById('pageStrictMode').checked;
      const hasFile = fileInput && fileInput.files && fileInput.files.length > 0;

      if (!rawText && !hasFile) {
        renderToolError('يرجى رفع ملف محاضرة (PDF أو TXT) أو لصق نص المحاضرة في الحقل المخصص.');
        return;
      }

      setToolLoadingState(true, 'جارٍ استخراج النص وتحليل المحاضرة...');
      document.getElementById('toolOutputContainer').innerHTML = '';

      try {
        let combinedText = '';
        let truncationNotice = '';

        if (hasFile) {
          const extracted = await extractFileLocally('pagePdfInput');
          if (extracted && (extracted.type === 'pdf-text' || extracted.type === 'text')) {
            combinedText += extracted.content + '\n\n';
            if (extracted.totalPages && extracted.totalPages > extracted.processedPages) {
              truncationNotice = `تنبيه: يحتوي ملف PDF على ${extracted.totalPages} صفحة؛ تمت معالجة أول ${extracted.processedPages} صفحة محلياً لضمان عدم تجاوز حدود حجم الطلب.`;
            }
          }
        }

        if (rawText) {
          combinedText += `=== [نص مضاف يدوياً] ===\n${rawText}`;
        }

        if (!combinedText.trim()) {
          throw new Error('لم يتم العثور على نص قابل للتحليل.');
        }

        const systemInstruction = `أنت محلل محتوى أكاديمي طبي. قم بتحليل نص المحاضرة المقدم وتنظيمه في الأقسام الواضحة التالية:
1. العناوين والأفكار الأساسية المنظمة.
2. قاموس المصطلحات الطبية والتعريفات الواردة (مع الحفاظ على المصطلح الإنجليزي).
3. الآليات الفيزيولوجية أو المرضية المذكورة.
4. أسئلة مراجعة متوقعة (High-Yield Questions) مع إجاباتها.
5. النقاط المعقدة التي تحتاج من الطالب إلى مراجعة إضافية.
${strictMode
  ? 'تنبيه صارم: وضع الالتزام بالمصدر مفعل؛ لا تضف أي معلومة أو تعريف غير موجود في النص المقدم من المستخدم.'
  : 'إذا أضفت توضيحاً تكميلياً من خارج النص فميّزه بوضوح بعبارة [إضافة توضيحية].'}`;

        const output = await callGeminiAPI({
          systemInstruction,
          contents: [{ role: 'user', parts: [{ text: combinedText }] }]
        });

        renderToolOutput(output, truncationNotice);
      } catch (err) {
        renderToolError(err.message, executePageIntelligence);
      } finally {
        setToolLoadingState(false);
      }
    }

    // 8. AnatomyVision
    async function executeAnatomyVision() {
      if (APP_STATE.isRequestInFlight) return;
      const query = document.getElementById('anatomyQuery').value.trim();
      const fileInput = document.getElementById('anatomyImageInput');
      const hasFile = fileInput && fileInput.files && fileInput.files.length > 0;

      if (!query && !hasFile) {
        renderToolError('يرجى إدخال اسم التركيب التشريحي أو إرفاق صورة تشريحية لدراستها.');
        return;
      }

      setToolLoadingState(true, 'جارٍ إعداد الشرح التشريحي والعلاقات السريرية...');
      document.getElementById('toolOutputContainer').innerHTML = '';

      const systemInstruction = `أنت أستاذ علم التشريح السريري (Clinical Anatomy).
اشرح التركيب التشريحي المطلوب أو الصورة التشريحية المرفقة ضمن أقسام منظمة:
1. نظرة عامة والموقع التشريحي الدقيق.
2. العلاقات التشريحية المجاورة (Anatomical Relations: Anterior, Posterior, Superior, Inferior, Medial, Lateral).
3. التروية الدموية والتعصيب (Blood Supply & Innervation) والتصريف اللمفاوي عند ملاءمته.
4. الوظيفة الفيزيولوجية والحركية.
5. الأهمية السريرية وإصابات التركيب (Clinical Correlations).
قواعد صارمة:
- إذا أرفق المستخدم صورة، اشرح التراكيب الواضحة فيها فقط، وبيّن بوضوح أي حدود تمنع الجزم بتركيب غير ظاهر أو غير واضح، ولا تختلق علامات تشريحية غير مرئية.
- هذه الأداة تحلل وتشرح التراكيب ولا تقوم بتوليد أو رسم صور تشريحية جديدة.`;

      try {
        const parts = [];
        if (query) {
          parts.push({ text: `التركيب التشريحي أو السؤال: ${query}` });
        } else {
          parts.push({ text: 'اشرح التراكيب التشريحية الظاهرة في الصورة المرفقة وعلاقاتها وأهميتها السريرية، مع توضيح أي قيود في وضوح الصورة.' });
        }

        if (hasFile) {
          const imgData = await extractFileLocally('anatomyImageInput');
          if (imgData && imgData.type === 'image') {
            parts.push({
              inline_data: {
                mime_type: imgData.mimeType,
                data: imgData.base64
              }
            });
          }
        }

        const output = await callGeminiAPI({
          systemInstruction,
          contents: [{ role: 'user', parts }]
        });
        renderToolOutput(output);
      } catch (err) {
        renderToolError(err.message, executeAnatomyVision);
      } finally {
        setToolLoadingState(false);
      }
    }
  </script>
