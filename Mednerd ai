    // 5. MedPatient (محاكاة سريرية متعددة الأدوار عبر الدالة الموحدة)
    const PATIENT_SYSTEM_PROMPT = `أنت مريض افتراضي في محاكاة تعليمية لطلاب الطب للتدرب على أخذ القصة المرضية (History Taking).
قواعد التقمص السريري:
1. تحدث بلسان المريض فقط وبأسلوب واقعي، ولا تكشف جميع معلومات الحالة دفعة واحدة؛ اكشف فقط ما يسأل عنه الطالب بشكل مناسب.
2. لا تذكر اسم التشخيص الطبي النهائي أثناء الحوار.
3. عندما يطلب منك النظام تقديم [تقييم الأداء السريري النهائي]، اخرج من دور المريض وقدم تقريراً أكاديمياً منظماً يشمل:
   - التشخيص التفريقي والمرجح للحالة التعليمية.
   - النقاط الإيجابية التي سأل عنها الطالب في القصة المرضية.
   - النقاط والعلامات المنذرة (Red Flags) التي أغفلها الطالب.
   - نصائح عملية لتحسين مهارة التواصل السريري.`;

    async function startMedPatientCase() {
      if (APP_STATE.isRequestInFlight) return;
      const complaint = document.getElementById('patientComplaint').value.trim() || 'ألم صدري حاد بدأ منذ ساعتين لدى مريض عمره 54 عاماً';
      const level = document.getElementById('patientLevel').value;

      setToolLoadingState(true, 'جارٍ تهيئة سيناريو المريض الافتراضي...');
      document.getElementById('toolOutputContainer').innerHTML = '';

      APP_STATE.patientCaseContext = `الشكوى/الموضوع: ${complaint} | مستوى الصعوبة: ${level}`;
      APP_STATE.patientHistory = [
        {
          role: 'user',
          parts: [{
            text: `ابدأ سيناريو مريض افتراضي جديد وفق المعطيات التالية: (${APP_STATE.patientCaseContext}). قدم نفسك كالمريض باختصار (العمر والشكوى الرئيسية التي جلبتك للعيادة أو الطوارئ في جملتين فقط) وانتظر أسئلة الطالب.`
          }]
        }
      ];

      try {
        const firstReply = await callGeminiAPI({
          systemInstruction: PATIENT_SYSTEM_PROMPT,
          contents: APP_STATE.patientHistory
        });

        APP_STATE.patientHistory.push({ role: 'model', parts: [{ text: firstReply }] });
        renderPatientChatInterface(firstReply);
      } catch (err) {
        renderToolError(err.message, startMedPatientCase);
      } finally {
        setToolLoadingState(false);
      }
    }

