    function clearApiKey() {
      localStorage.removeItem('mednerd_gemini_key');
      APP_STATE.sessionOnlyKey = '';
      document.getElementById('apiKeyInput').value = '';
      setConnectionStatus('no-key');
      const resultNode = document.getElementById('connectionTestResult');
      resultNode.style.color = 'var(--danger)';
      resultNode.textContent = 'تم حذف المفتاح من المتصفح والذاكرة المؤقتة بنجاح.';
    }

    async function testApiConnection() {
      const typedKey = document.getElementById('apiKeyInput').value.trim();
      const keyToTest = typedKey || getActiveApiKey();
      const resultNode = document.getElementById('connectionTestResult');
      const testBtn = document.getElementById('testConnectionBtn');

      if (!keyToTest) {
        setConnectionStatus('no-key');
        resultNode.style.color = 'var(--danger)';
        resultNode.textContent = 'لم تتم إضافة مفتاح. يرجى إدخال مفتاح Gemini API لاختباره.';
        return;
      }

      // إذا أدخل المستخدم مفتاحاً في الحقل وضغط اختبار مباشرة دون حفظ، نضعه كمؤقت للجلسة
      if (typedKey && !getActiveApiKey()) {
        APP_STATE.sessionOnlyKey = typedKey;
        document.getElementById('apiKeyInput').value = '';
      }

      setConnectionStatus('verifying');
      testBtn.disabled = true;
      resultNode.style.color = 'var(--petrol)';
      resultNode.textContent = 'جارٍ التحقق من الاتصال الفعلي بـ Gemini API...';

      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), 15000);

      try {
        const response = await fetch(GEMINI_CONFIG.endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'x-goog-api-key': keyToTest
          },
          body: JSON.stringify({
            contents: [{ role: 'user', parts: [{ text: 'أجب بكلمة: متصل' }] }],
            generationConfig: { maxOutputTokens: 10 }
          }),
          signal: controller.signal
        });

        clearTimeout(timer);

        if (response.ok) {
          setConnectionStatus('connected');
          resultNode.style.color = 'var(--dark-green)';
          resultNode.textContent = '✓ الاتصال ناجح! المفتاح صالح وجاهز لتشغيل جميع الأدوات.';
        } else {
          const mapped = mapHttpErrorToArabic(response.status);
          setConnectionStatus(mapped.status);
          resultNode.style.color = 'var(--danger)';
          resultNode.textContent = mapped.message;
        }
      } catch (err) {
        clearTimeout(timer);
        setConnectionStatus('network-error');
        resultNode.style.color = 'var(--danger)';
        resultNode.textContent = err.name === 'AbortError'
          ? 'انتهت مهلة الاتصال بالخدمة. يرجى التحقق من جودة الإنترنت والمحاولة مجدداً.'
          : 'تعذر الاتصال بخدمة Gemini API. تأكد من اتصالك بالإنترنت.';
      } finally {
        testBtn.disabled = false;
      }
    }

    function mapHttpErrorToArabic(statusCode) {
      if (statusCode === 400 || statusCode === 401 || statusCode === 403) {
        return {
          status: 'invalid',
          message: 'المفتاح غير صالح أو غير مخول لإجراء هذا الطلب. تأكد من نسخ المفتاح الصحيح من Google AI Studio.'
        };
      }
      if (statusCode === 429) {
        return {
          status: 'quota',
          message: 'تم تجاوز حدود الاستخدام المسموحة لمفتاحك (Rate Limit / Quota). انتظر قليلاً أو راجع حصة حسابك في Google AI.'
        };
      }
      if (statusCode === 404) {
        return {
          status: 'network-error',
          message: 'النموذج المطلوب غير متوفر حالياً لهذا المفتاح.'
        };
      }
      return {
        status: 'network-error',
        message: `تعذر إتمام الطلب (رمز الحالة: ${statusCode}). يرجى المحاولة لاحقاً.`
      };
    }

    /**************************************************************
     * 4. دالة الاتصال الموحدة بـ Gemini API (بدون تسريب المفتاح في URL)
     **************************************************************/
    async function callGeminiAPI({ systemInstruction, contents, generationConfig = {} }) {
      const apiKey = getActiveApiKey();
      if (!apiKey) {
        openApiKeyModal();
        throw new Error('لم تتم إضافة مفتاح Gemini API. يرجى إدخال مفتاحك أولاً لتشغيل الأداة.');
      }

      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), GEMINI_CONFIG.timeoutMs);

      const payload = {
        contents: contents,
        generationConfig: {
          temperature: 0.35,
          ...generationConfig
        }
      };

      if (systemInstruction) {
        payload.systemInstruction = {
          parts: [{ text: systemInstruction }]
        };
      }

      try {
        const response = await fetch(GEMINI_CONFIG.endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'x-goog-api-key': apiKey
          },
          body: JSON.stringify(payload),
          signal: controller.signal
        });

        clearTimeout(timeoutId);

        if (!response.ok) {
          const mapped = mapHttpErrorToArabic(response.status);
          setConnectionStatus(mapped.status);
          throw new Error(mapped.message);
        }

        const data = await response.json();

        if (!data || !Array.isArray(data.candidates) || data.candidates.length === 0) {
          throw new Error('تلقى المتصفح استجابة فارغة من النموذج. حاول تعديل النص المدخل وإعادة المحاولة.');
        }

        const candidate = data.candidates[0];
        if (candidate.finishReason === 'SAFETY' || candidate.finishReason === 'BLOCKLIST') {
          throw new Error('تم إيقاف الاستجابة بواسطة سياسات الأمان الخاصة بالنموذج. يرجى صياغة المدخلات بأسلوب أكاديمي واضح.');
        }

        const parts = candidate.content && candidate.content.parts;
        if (!parts || !parts[0] || typeof parts[0].text !== 'string' || !parts[0].text.trim()) {
          throw new Error('استجابة غير مكتملة من النموذج. يرجى الضغط على زر إعادة المحاولة.');
        }

        // تحديث حالة الاتصال إلى متصل فعلياً بعد نجاح الطلب
        setConnectionStatus('connected');
        return parts[0].text;
      } catch (err) {
        clearTimeout(timeoutId);
        if (err.name === 'AbortError') {
          throw new Error('انتهت مهلة الطلب بسبب طول المحتوى أو بطء الإنترنت. حاول تقسيم النص إلى أجزاء أصغر ثم أعد المحاولة.');
        }
        if (err.message && err.message.includes('Failed to fetch')) {
          setConnectionStatus('network-error');
          throw new Error('انقطاع في الاتصال بالإنترنت أو تعذر الوصول إلى خوادم Google Gemini.');
        }
        throw err;
      }
    }

    /**************************************************************
     * 5. تعقيم المخرجات ومعالجة الملفات محلياً (PDF وصور)
     **************************************************************/
    function renderSafeMarkdown(markdownText) {
      const rawHtml = typeof marked !== 'undefined' ? marked.parse(markdownText) : markdownText;
      return DOMPurify.sanitize(rawHtml, {
        USE_PROFILES: { html: true },
        FORBID_TAGS: ['script', 'iframe', 'object', 'embed', 'form', 'input', 'button', 'style', 'link', 'meta'],
        FORBID_ATTR: ['onerror', 'onload', 'onclick', 'onmouseover', 'onfocus', 'style']
      });
    }

    async function extractFileLocally(fileInputId) {
      const input = document.getElementById(fileInputId);
      if (!input || !input.files || input.files.length === 0) return null;

      const file = input.files[0];
      if (file.size === 0) {
        throw new Error('الملف المختار فارغ (0 بايت). يرجى اختيار ملف صالح.');
      }
      if (file.size > GEMINI_CONFIG.maxFileSizeBytes) {
        throw new Error('حجم الملف كبير جداً. الحد الأقصى المسموح للمعالجة في المتصفح هو 12 ميجابايت.');
      }

      // معالجة ملفات PDF محلياً عبر PDF.js
      if (file.type === 'application/pdf' || file.name.toLowerCase().endsWith('.pdf')) {
        if (!window.pdfjsLib) {
          throw new Error('مكتبة قراءة ملفات PDF غير محملة حالياً. تحقق من اتصال الإنترنت أو ألصق النص يدوياً.');
        }
        try {
          const arrayBuffer = await file.arrayBuffer();
          const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
          const totalPages = pdf.numPages;
          const pagesToRead = Math.min(totalPages, GEMINI_CONFIG.maxPdfPages);
          let extractedText = '';
          let nonWhitespaceCount = 0;

          for (let pageNum = 1; pageNum <= pagesToRead; pageNum++) {
            const page = await pdf.getPage(pageNum);
            const textContent = await page.getTextContent();
            const pageStr = textContent.items.map(item => item.str).join(' ').trim();
            if (pageStr.length > 0) {
              nonWhitespaceCount += pageStr.length;
              extractedText += `\n=== [صفحة ${pageNum} من ${totalPages}] ===\n${pageStr}\n`;
            }
          }

          if (nonWhitespaceCount < 20) {
            throw new Error('تعذر استخراج نص قابل للقراءة من ملف PDF لأن الملف يبدو ممسوحاً ضوئياً كصور (Scanned PDF) ولا يحتوي على طبقة نصية. يرجى نسخ النص أو استخدام ملف نصي.');
          }

          return {
            type: 'pdf-text',
            content: extractedText,
            totalPages: totalPages,
            processedPages: pagesToRead
          };
        } catch (pdfErr) {
          if (pdfErr.message.includes('Scanned PDF')) throw pdfErr;
          throw new Error('تعذر قراءة ملف PDF محلياً (قد يكون الملف محمياً بكلمة مرور أو تالفاً).');
        }
      }

      // معالجة الصور
      const allowedImageTypes = ['image/png', 'image/jpeg', 'image/webp'];
      if (allowedImageTypes.includes(file.type)) {
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => {
            const parts = String(reader.result).split(',');
            if (parts.length < 2 || !parts[1]) {
              reject(new Error('تعذر قراءة بيانات الصورة.'));
              return;
            }
            resolve({
              type: 'image',
              base64: parts[1],
              mimeType: file.type,
              name: file.name
            });
          };
          reader.onerror = () => reject(new Error('حدث خطأ أثناء قراءة ملف الصورة من جهازك.'));
          reader.readAsDataURL(file);
        });
      }

      // معالجة الملفات النصية العادية
      if (file.type === 'text/plain' || file.name.toLowerCase().endsWith('.txt')) {
        const text = await file.text();
        if (!text.trim()) throw new Error('الملف النصي فارغ.');
        return { type: 'text', content: text };
      }

      throw new Error('نوع الملف غير مدعوم. الأنواع المدعومة هي: PDF نصي، صور (PNG, JPG, WEBP)، أو ملف نصي (TXT).');
    }

    /**************************************************************
     * 6. عرض شبكة الأدوات والبحث ثنائي اللغة
     **************************************************************/
    function renderTools(list) {
      const container = document.getElementById('toolsContainer');
      container.innerHTML = '';

      if (list.length === 0) {
        const emptyDiv = document.createElement('div');
        emptyDiv.style.cssText = 'text-align:center; padding: 48px 20px; color: var(--muted-text); font-weight: 600;';
        emptyDiv.textContent = 'لا توجد أدوات مطابقة لعبارة البحث. جرب البحث بكلمات مثل: ECG، Flashcards، تشريح، PDF.';
        container.appendChild(emptyDiv);
        return;
      }

      const section = document.createElement('div');
      section.className = 'category-section';

      const title = document.createElement('div');
      title.className = 'category-title';
      title.innerHTML = '<i class="fa-solid fa-Layer-group"></i><span>الأدوات التعليمية الذكية المتاحة</span>';
      section.appendChild(title);

      const grid = document.createElement('div');
      grid.className = 'tools-grid';

      list.forEach(tool => {
        const card = document.createElement('div');
        card.className = 'tool-card';
        card.setAttribute('tabindex', '0');
        card.setAttribute('role', 'button');
        card.setAttribute('aria-label', `فتح أداة ${tool.name}`);
        card.onclick = () => openToolWorkspace(tool.id);
        card.onkeydown = (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            openToolWorkspace(tool.id);
          }
        };

        card.innerHTML = `
          <div>
            <div class="tool-header">
              <div class="tool-icon"><i class="fa-solid ${tool.icon}"></i></div>
              <span class="tool-badge">${tool.badge}</span>
            </div>
            <h3 class="tool-name"></h3>
            <p class="tool-desc"></p>
          </div>
          <div class="tool-footer">
            <span>فتح مساحة العمل</span>
            <i class="fa-solid fa-arrow-left"></i>
          </div>
        `;
        card.querySelector('.tool-name').textContent = tool.name;
        card.querySelector('.tool-desc').textContent = tool.desc;
        grid.appendChild(card);
      });

      section.appendChild(grid);
      container.appendChild(section);
    }

    function setCategory(cat, btnElement) {
      APP_STATE.currentCategory = cat;
      document.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
      btnElement.classList.add('active');
      filterTools();
    }

    function filterTools() {
      const q = document.getElementById('searchInput').value.trim().toLowerCase();
      const filtered = TOOLS_DATA.filter(tool => {
        const catMatch = APP_STATE.currentCategory === 'all' || tool.category === APP_STATE.currentCategory;
        const textMatch = !q ||
          tool.name.toLowerCase().includes(q) ||
          tool.desc.toLowerCase().includes(q) ||
          tool.keywords.toLowerCase().includes(q);
        return catMatch && textMatch;
      });
      renderTools(filtered);
    }

    /**************************************************************
     * 7. بناء واجهات الأدوات الثماني ونظام التشغيل الموحد
     **************************************************************/
    function openToolWorkspace(toolId) {
      const tool = TOOLS_DATA.find(t => t.id === toolId);
      if (!tool) return;

      APP_STATE.activeToolId = toolId;
      APP_STATE.lastRetryCallback = null;

      document.getElementById('modalToolTitle').textContent = tool.name;
      document.getElementById('modalToolSubtitle').textContent = tool.desc;

      const body = document.getElementById('workspaceBodyContent');
      body.innerHTML = buildToolFormHTML(toolId);

      document.getElementById('workspaceModal').style.display = 'flex';
      updateBodyScrollLock();
    }

    function closeWorkspace() {
      if (APP_STATE.isRequestInFlight) return;
      document.getElementById('workspaceModal').style.display = 'none';
      APP_STATE.activeToolId = null;
      updateBodyScrollLock();
    }

