<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- سياسة أمان المحتوى (CSP) لتقييد إرسال البيانات حصراً إلى واجهة Google Gemini API -->
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob:; connect-src https://generativelanguage.googleapis.com; worker-src 'self' blob: https://cdnjs.cloudflare.com;">
  <title>MEDNERD | Learn. Practice. Understand.</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- مكتبة الاحتفال الترحيبي -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
  <!-- مكتبة معالجة ملفات PDF محلياً داخل المتصفح -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <script>
    if (window.pdfjsLib) {
      pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    }
  </script>
  <!-- مكتبة تعقيم المخرجات لمنع ثغرات XSS -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.0.8/purify.min.js"></script>
  <!-- مكتبة تحويل Markdown إلى HTML منظم -->
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

  <style>
    /* الهوية البصرية الأساسية - الوضع النهاري */
    :root {
      --bg-main: #fdfbf7;
      --bg-elevated: #f5f2eb;
      --petrol: #0e7490;
      --petrol-hover: #0b5c73;
      --petrol-soft: rgba(14, 116, 144, 0.08);
      --dark-green: #14532d;
      --dark-green-soft: rgba(20, 83, 45, 0.1);
      --mustard: #b45309;
      --mustard-soft: rgba(180, 83, 9, 0.09);
      --white: #ffffff;
      --dark-text: #17202a;
      --muted-text: #4b5563;
      --border-color: #e5e7eb;
      --danger: #dc2626;
      --danger-soft: rgba(220, 38, 38, 0.08);
      --shadow-sm: 0 4px 6px -1px rgba(14, 116, 144, 0.05), 0 2px 4px -2px rgba(14, 116, 144, 0.05);
      --shadow-md: 0 10px 15px -3px rgba(14, 116, 144, 0.08), 0 4px 6px -4px rgba(14, 116, 144, 0.08);
      --modal-backdrop: rgba(23, 32, 42, 0.65);
    }

    /* الهوية البصرية - الوضع الليلي (Dark Mode) مع الحفاظ على تناسق الألوان الأكاديمية */
    [data-theme="dark"] {
      --bg-main: #0f172a;
      --bg-elevated: #1e293b;
      --petrol: #22d3ee;
      --petrol-hover: #06b6d4;
      --petrol-soft: rgba(34, 211, 238, 0.12);
      --dark-green: #4ade80;
      --dark-green-soft: rgba(74, 222, 128, 0.14);
      --mustard: #fbbf24;
      --mustard-soft: rgba(251, 191, 36, 0.12);
      --white: #1e293b;
      --dark-text: #f1f5f9;
      --muted-text: #94a3b8;
      --border-color: #334155;
      --danger: #f87171;
      --danger-soft: rgba(248, 113, 113, 0.12);
      --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
      --shadow-md: 0 12px 20px -3px rgba(0, 0, 0, 0.45);
      --modal-backdrop: rgba(2, 6, 23, 0.8);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Cairo', 'Inter', sans-serif;
    }

    body {
      background-color: var(--bg-main);
      color: var(--dark-text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
      transition: background-color 0.25s ease, color 0.25s ease;
      line-height: 1.6;
    }

    body.modal-open {
      overflow: hidden;
    }

    /* النوافذ المنبثقة (Modals) */
    .modal-overlay, .workspace-modal {
      position: fixed;
      inset: 0;
      background: var(--modal-backdrop);
      backdrop-filter: blur(6px);
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
      animation: fadeIn 0.25s ease forwards;
    }

    .modal-card {
      background: var(--white);
      border-radius: 24px;
      max-width: 620px;
      width: 100%;
      max-height: 92vh;
      overflow-y: auto;
      padding: 36px 32px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.3);
      text-align: center;
      border: 1px solid var(--border-color);
      animation: scaleUp 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .quran-verse {
      font-size: 28px;
      font-weight: 800;
      color: var(--dark-green);
      line-height: 1.6;
      margin-bottom: 8px;
    }

    .quran-reference {
      font-size: 14px;
      color: var(--petrol);
      font-weight: 700;
      margin-bottom: 24px;
    }

    .tribute-box {
      background: var(--mustard-soft);
      border-right: 4px solid var(--mustard);
      padding: 18px;
      border-radius: 12px;
      margin-bottom: 24px;
      font-size: 15px;
      color: var(--dark-text);
      text-align: right;
      line-height: 1.75;
    }

    .tribute-box b {
      color: var(--mustard);
    }

    /* الأزرار */
    .btn-primary {
      background: #0e7490;
      color: #ffffff;
      border: none;
      padding: 12px 28px;
      font-size: 16px;
      font-weight: 700;
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-decoration: none;
      box-shadow: 0 4px 12px rgba(14, 116, 144, 0.25);
    }

    .btn-primary:hover:not(:disabled) {
      background: #0b5c73;
      transform: translateY(-1px);
    }

    .btn-primary:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none;
    }

    .btn-secondary {
      background: transparent;
      color: var(--petrol);
      border: 1px solid var(--petrol);
      padding: 10px 18px;
      font-size: 14px;
      font-weight: 700;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      text-decoration: none;
    }

    .btn-secondary:hover:not(:disabled) {
      background: var(--petrol-soft);
    }

    .btn-secondary:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .btn-telegram {
      background: #0088cc;
      color: #ffffff;
      border: none;
      padding: 10px 20px;
      font-size: 14px;
      font-weight: 700;
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-decoration: none;
    }

    .btn-telegram:hover {
      background: #0077b5;
      transform: translateY(-1px);
    }

    /* شريط التنقل العلوي */
    header {
      background: var(--white);
      border-bottom: 1px solid var(--border-color);
      position: sticky;
      top: 0;
      z-index: 100;
      transition: background-color 0.25s ease, border-color 0.25s ease;
    }

    .nav-container {
      max-width: 1300px;
      margin: 0 auto;
      padding: 14px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
    }

    .logo-area {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
    }

    .logo-icon {
      width: 42px;
      height: 42px;
      background: #0e7490;
      color: #ffffff;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      font-weight: 800;
    }

    .logo-text {
      font-size: 24px;
      font-weight: 800;
      color: var(--petrol);
      letter-spacing: -0.5px;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .theme-toggle-btn {
      background: var(--bg-elevated);
      color: var(--dark-text);
      border: 1px solid var(--border-color);
      width: 40px;
      height: 40px;
      border-radius: 12px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 17px;
      transition: all 0.2s;
    }

    .theme-toggle-btn:hover {
      border-color: var(--petrol);
      color: var(--petrol);
    }

    .api-key-status {
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--petrol-soft);
      padding: 8px 16px;
      border-radius: 30px;
      font-size: 13px;
      font-weight: 700;
      color: var(--petrol);
      cursor: pointer;
      border: 1px solid var(--border-color);
      transition: all 0.2s;
    }

    .api-key-status:hover {
      border-color: var(--petrol);
    }

    .status-dot {
      width: 9px;
      height: 9px;
      background: #9ca3af;
      border-radius: 50%;
      transition: all 0.3s;
    }

    .status-dot.unverified {
      background: var(--mustard);
      box-shadow: 0 0 6px var(--mustard);
    }

    .status-dot.verifying {
      background: var(--petrol);
      animation: pulseDot 1s infinite;
    }

    .status-dot.connected {
      background: var(--dark-green);
      box-shadow: 0 0 8px var(--dark-green);
    }

    .status-dot.error {
      background: var(--danger);
      box-shadow: 0 0 8px var(--danger);
    }

    @keyframes pulseDot {
      0%, 100% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.35); opacity: 0.5; }
    }

    /* المحتوى الرئيسي */
    main {
      max-width: 1300px;
      margin: 0 auto;
      padding: 36px 24px;
      flex: 1;
      width: 100%;
    }

    .hero-section {
      text-align: center;
      margin-bottom: 40px;
    }

    .hero-badges {
      display: flex;
      justify-content: center;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 14px;
    }

    .hero-badge {
      font-size: 12px;
      font-weight: 700;
      padding: 5px 14px;
      border-radius: 20px;
      background: var(--petrol-soft);
      color: var(--petrol);
      border: 1px solid var(--border-color);
    }

    .hero-title {
      font-size: 40px;
      font-weight: 800;
      color: var(--petrol);
      margin-bottom: 12px;
    }

    .hero-subtitle {
      font-size: 17px;
      color: var(--muted-text);
      max-width: 740px;
      margin: 0 auto 28px auto;
      line-height: 1.7;
    }

    /* البحث والتصنيفات */
    .search-filter-bar {
      display: flex;
      flex-direction: column;
      gap: 16px;
      max-width: 720px;
      margin: 0 auto 36px auto;
    }

    .search-box {
      position: relative;
      width: 100%;
    }

    .search-box i {
      position: absolute;
      right: 18px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--petrol);
      font-size: 18px;
    }

    .search-input {
      width: 100%;
      padding: 15px 50px 15px 20px;
      background: var(--white);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      font-size: 15px;
      color: var(--dark-text);
      box-shadow: var(--shadow-sm);
      outline: none;
      transition: all 0.2s;
    }

    .search-input:focus {
      border-color: var(--petrol);
      box-shadow: 0 0 0 3px var(--petrol-soft);
    }

    .filter-pills {
      display: flex;
      gap: 10px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .filter-pill {
      background: var(--white);
      border: 1px solid var(--border-color);
      padding: 8px 18px;
      border-radius: 30px;
      font-size: 14px;
      font-weight: 700;
      color: var(--dark-text);
      cursor: pointer;
      transition: all 0.2s;
    }

    .filter-pill:hover, .filter-pill.active {
      background: #0e7490;
      color: #ffffff;
      border-color: #0e7490;
    }

    /* شبكة الأدوات */
    .category-section {
      margin-bottom: 44px;
    }

    .category-title {
      font-size: 21px;
      font-weight: 800;
      color: var(--petrol);
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 10px;
      border-right: 4px solid var(--petrol);
      padding-right: 12px;
    }

    .tools-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
      gap: 20px;
    }

    .tool-card {
      background: var(--white);
      border: 1px solid var(--border-color);
      border-radius: 18px;
      padding: 24px;
      box-shadow: var(--shadow-sm);
      transition: all 0.25s ease;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      text-align: right;
    }

    .tool-card:hover, .tool-card:focus-visible {
      transform: translateY(-4px);
      box-shadow: var(--shadow-md);
      border-color: var(--petrol);
      outline: none;
    }

    .tool-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 14px;
    }

    .tool-icon {
      width: 48px;
      height: 48px;
      background: var(--petrol-soft);
      color: var(--petrol);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
    }

    .tool-badge {
      font-size: 12px;
      font-weight: 700;
      background: var(--dark-green-soft);
      color: var(--dark-green);
      padding: 4px 10px;
      border-radius: 8px;
    }

    .tool-name {
      font-size: 19px;
      font-weight: 800;
      color: var(--petrol);
      margin-bottom: 8px;
    }

    .tool-desc {
      font-size: 14px;
      color: var(--muted-text);
      line-height: 1.6;
      margin-bottom: 20px;
    }

    .tool-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 14px;
      font-weight: 700;
      color: var(--petrol);
      padding-top: 12px;
      border-top: 1px solid var(--border-color);
    }

    .tool-footer i {
      transition: transform 0.2s;
    }

    .tool-card:hover .tool-footer i {
      transform: translateX(-5px);
    }

    /* نافذة تشغيل الأداة الموحدة */
    .workspace-card {
      background: var(--white);
      border-radius: 22px;
      max-width: 920px;
      width: 100%;
      max-height: 92vh;
      display: flex;
      flex-direction: column;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35);
      border: 1px solid var(--border-color);
      overflow: hidden;
      animation: scaleUp 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .workspace-header {
      padding: 20px 24px;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: var(--bg-elevated);
      gap: 12px;
    }

    .workspace-title-area h2 {
      font-size: 21px;
      font-weight: 800;
      color: var(--petrol);
      margin-bottom: 2px;
    }

    .workspace-title-area p {
      font-size: 13.5px;
      color: var(--muted-text);
    }

    .close-btn {
      background: var(--white);
      border: 1px solid var(--border-color);
      font-size: 18px;
      color: var(--dark-text);
      cursor: pointer;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: all 0.2s;
    }

    .close-btn:hover {
      border-color: var(--danger);
      color: var(--danger);
    }

    .workspace-body {
      padding: 24px;
      overflow-y: auto;
      flex: 1;
    }

    /* الحقول والنماذج */
    .form-group {
      margin-bottom: 18px;
    }

    .form-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 14px;
      margin-bottom: 18px;
    }

    .form-label {
      display: block;
      font-size: 14px;
      font-weight: 700;
      color: var(--petrol);
      margin-bottom: 8px;
    }

    .form-textarea, .form-input, .form-select {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid var(--border-color);
      border-radius: 12px;
      font-size: 15px;
      color: var(--dark-text);
      background: var(--bg-main);
      outline: none;
      transition: border 0.2s, box-shadow 0.2s;
    }

    .form-textarea:focus, .form-input:focus, .form-select:focus {
      border-color: var(--petrol);
      box-shadow: 0 0 0 3px var(--petrol-soft);
    }

    .checkbox-label {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 14px;
      font-weight: 600;
      color: var(--dark-text);
      cursor: pointer;
      user-select: none;
    }

    .checkbox-label input {
      width: 18px;
      height: 18px;
      accent-color: #0e7490;
    }

    .toolbar-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items: center;
      margin-top: 8px;
    }

    .privacy-note {
      font-size: 12.5px;
      color: var(--muted-text);
      background: var(--bg-elevated);
      padding: 10px 14px;
      border-radius: 10px;
      margin-top: 14px;
      border: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* منطقة المخرجات وتنسيق الجداول والنصوص الطبية */
    .ai-output-box {
      background: var(--bg-main);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 24px;
      margin-top: 22px;
      font-size: 15.5px;
      line-height: 1.85;
      color: var(--dark-text);
      overflow-x: auto;
    }

    .ai-output-box h1, .ai-output-box h2, .ai-output-box h3, .ai-output-box h4 {
      color: var(--petrol);
      margin-top: 18px;
      margin-bottom: 10px;
      font-weight: 800;
    }

    .ai-output-box h1:first-child, .ai-output-box h2:first-child, .ai-output-box h3:first-child {
      margin-top: 0;
    }

    .ai-output-box p {
      margin-bottom: 12px;
    }

    .ai-output-box ul, .ai-output-box ol {
      padding-right: 22px;
      margin-bottom: 14px;
    }

    .ai-output-box li {
      margin-bottom: 6px;
    }

    .ai-output-box strong, .ai-output-box b {
      color: var(--petrol);
    }

    .ai-output-box blockquote {
      border-right: 4px solid var(--dark-green);
      background: var(--dark-green-soft);
      padding: 12px 16px;
      border-radius: 8px;
      margin: 14px 0;
      color: var(--dark-text);
    }

    .ai-output-box table {
      width: 100%;
      border-collapse: collapse;
      margin: 16px 0;
      font-size: 14.5px;
    }

    .ai-output-box th {
      background: #0e7490;
      color: #ffffff;
      padding: 10px 14px;
      text-align: right;
      border: 1px solid var(--border-color);
    }

    .ai-output-box td {
      padding: 10px 14px;
      border: 1px solid var(--border-color);
      background: var(--white);
    }

    .output-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 18px;
      padding-top: 16px;
      border-top: 1px solid var(--border-color);
    }

    /* التنبيهات ورسائل الخطأ */
    .warning-alert {
      background: var(--mustard-soft);
      border: 1px solid var(--mustard);
      color: var(--mustard);
      padding: 12px 16px;
      border-radius: 12px;
      font-size: 14px;
      font-weight: 600;
      margin-top: 16px;
      display: flex;
      align-items: flex-start;
      gap: 10px;
      line-height: 1.6;
    }

    .error-alert {
      background: var(--danger-soft);
      border: 1px solid var(--danger);
      color: var(--danger);
      padding: 14px 16px;
      border-radius: 12px;
      font-size: 14.5px;
      font-weight: 600;
      margin-top: 18px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    /* محادثة المريض الافتراضي */
    .chat-container {
      border: 1px solid var(--border-color);
      border-radius: 14px;
      background: var(--bg-main);
      padding: 16px;
      max-height: 360px;
      overflow-y: auto;
      margin-bottom: 16px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .chat-bubble {
      padding: 12px 16px;
      border-radius: 14px;
      max-width: 85%;
      font-size: 14.5px;
      line-height: 1.7;
    }

