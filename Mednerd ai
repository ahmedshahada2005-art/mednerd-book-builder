        resultNode.textContent = 'يرجى إدخال مفتاح Gemini API أولاً قبل الحفظ.';
        return;
      }

      if (persistToLocal) {
        localStorage.setItem('mednerd_gemini_key', rawKey);
        APP_STATE.sessionOnlyKey = '';
      } else {
