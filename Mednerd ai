      if (APP_STATE.sessionOnlyKey) return APP_STATE.sessionOnlyKey;
      return localStorage.getItem('mednerd_gemini_key') || '';
    }

    function maskApiKey(key) {
      if (!key || key.length < 10) return '••••••••';
      return key.slice(0, 4) + '••••••••••••' + key.slice(-4);
    }

    function initStoredKeyState() {
      const key = getActiveApiKey();
      if (key) {
        // لا نعتبر المفتاح متصلاً لمجرد وجوده في localStorage؛ نضعه في حالة "بانتظار التحقق"
        setConnectionStatus('unverified');
      } else {
        setConnectionStatus('no-key');
      }
    }

    function setConnectionStatus(status, customMessage = '') {
      APP_STATE.connectionStatus = status;
      const dot = document.getElementById('statusDot');
      const text = document.getElementById('apiKeyStatusText');

      dot.className = 'status-dot';
      switch (status) {
        case 'no-key':
          text.textContent = 'لم تتم إضافة مفتاح';
          break;
        case 'unverified':
          dot.classList.add('unverified');
          text.textContent = 'مفتاح محفوظ (اضغط للتحقق)';
          break;
        case 'verifying':
          dot.classList.add('verifying');
          text.textContent = 'جارٍ التحقق من الاتصال...';
          break;
        case 'connected':
          dot.classList.add('connected');
          text.textContent = 'الاتصال ناجح';
          break;
        case 'invalid':
          dot.classList.add('error');
          text.textContent = 'المفتاح غير صالح أو غير مخول';
          break;
        case 'quota':
          dot.classList.add('error');
          text.textContent = 'تجاوز حدود الاستخدام';
          break;
        case 'network-error':
          dot.classList.add('error');
          text.textContent = customMessage || 'تعذر الاتصال بالخدمة';
          break;
      }
      refreshMaskedKeyBanner();
    }

    function refreshMaskedKeyBanner() {
      const banner = document.getElementById('maskedKeyBanner');
      const maskedText = document.getElementById('maskedKeyText');
      const badge = document.getElementById('keyStorageBadge');
