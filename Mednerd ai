      if (key) {
        banner.style.display = 'block';
        maskedText.textContent = maskApiKey(key);
        badge.textContent = APP_STATE.sessionOnlyKey ? 'مؤقت للجلسة فقط' : 'محفوظ في المتصفح';
      } else {
        banner.style.display = 'none';
        maskedText.textContent = '';
      }
